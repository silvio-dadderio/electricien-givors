---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config';
import { credits, lienLicence } from '../lib/photos';
const L = SITE.legal;
const val = (x: string) => x || 'à compléter';
---
<Base title="Mentions légales" description={`Mentions légales du site ${SITE.brand}.`} noindex>
  <div class="page-head">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Mentions légales' }]} />
      <h1>Mentions légales</h1>
    </div>
  </div>
  <section class="section">
    <div class="wrap prose">
      <h2>Éditeur du site</h2>
      <p>
        {L.editeur}<br />
        SIRET : <span class:list={[{ todo: !L.siret }]}>{val(L.siret)}</span><br />
        Adresse : <span class:list={[{ todo: !L.adresse }]}>{val(L.adresse)}</span><br />
        Téléphone : {SITE.phone}<br />
        E-mail : <span class:list={[{ todo: !L.email }]}>{val(L.email)}</span>
      </p>
      <p>Directeur de la publication : Enzo D'Adderio.</p>
      <h2>Réalisation des travaux</h2>
      <p>Les interventions et travaux sont réalisés par un artisan électricien partenaire.</p>
      <h2>Hébergement</h2>
      <p>
        <span class:list={[{ todo: !L.hebergeur }]}>{val(L.hebergeur)}</span><br />
        <span class:list={[{ todo: !L.hebergeurAdresse }]}>{val(L.hebergeurAdresse)}</span>
      </p>
      {credits.length > 0 && (
        <>
          <h2>Crédits photos</h2>
          <p>Photos d'illustration libres de droit. Elles ne représentent pas des chantiers réalisés par nos soins.</p>
          <ul>
            {credits.map((p) => {
              const lien = lienLicence(p.licence);
              return (
                <li>
                  {p.alt} : <a href={p.source} rel="nofollow noopener">{p.auteur}</a>, {new URL(p.source).hostname === 'commons.wikimedia.org' ? 'Wikimedia Commons' : new URL(p.source).hostname},{' '}
                  {lien ? <a href={lien} rel="nofollow noopener">{p.licence}</a> : p.licence}
                </li>
              );
            })}
          </ul>
        </>
      )}
      <h2>Propriété intellectuelle</h2>
      <p>Les textes de ce site sont la propriété de l'éditeur. Toute reproduction sans autorisation est interdite.</p>
    </div>
  </section>
</Base>
